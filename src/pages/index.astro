---
import Base from '../layouts/Base.astro';

const projects = [
  {
    name: 'Sonnen Buddy',
    kind: 'iOS app',
    blurb: 'A companion for your Sonnen home battery. Reads live status straight from the battery on your local network, with Live Activities on the lock screen.',
    href: '/sonnen-buddy',
    cta: 'Read more',
  },
  {
    name: 'Super Sinky',
    kind: 'Browser game',
    blurb: 'Multiplayer age-of-sail naval warfare. Wooden ships, broadsides, shifting wind and whirlpools — played in the browser with no install.',
    href: 'https://supersinky.bytestack.dk',
    cta: 'Play',
    external: true,
  },
];
---
<Base title="Bytestack">
  <h1>Bytestack</h1>
  <p class="lead">Small software projects — mobile apps, games, and whatever else is worth building.</p>

  <h2>Projects</h2>
  <ul class="cards">
    {projects.map((p) => (
      <li>
        <article>
          <div class="row">
            <h3>{p.name}</h3>
            <span class="kind">{p.kind}</span>
          </div>
          <p>{p.blurb}</p>
          <a href={p.href} {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}>
            {p.cta} <span aria-hidden="true">→</span>
          </a>
        </article>
      </li>
    ))}
  </ul>
</Base>

<style>
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  article {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius); padding: 20px;
  }
  .row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  h3 { margin: 0; font-size: 1.05rem; letter-spacing: -0.01em; }
  .kind {
    font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--accent); background: var(--accent-soft);
    padding: 3px 9px; border-radius: 999px; white-space: nowrap;
  }
  article p { color: var(--muted); font-size: 0.95rem; margin-bottom: 14px; }
  article a { font-size: 0.93rem; font-weight: 550; text-decoration: none; }
  article a:hover { text-decoration: underline; }
</style>
